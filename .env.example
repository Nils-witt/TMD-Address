POSTGRES_HOST=localhost
POSTGRES_PORT=5438
POSTGRES_USER=address_serv
POSTGRES_PASSWORD=address_serv
POSTGRES_DB=address_serv
LISTEN_ADDR=:8080
# Write requests require a bearer token issued by this OpenID Connect provider.
OIDC_ISSUER_URL=https://auth.example.com/realms/example
OIDC_AUDIENCE=address-serv
# Optional: override the JWKS URL found via OpenID discovery.
# OIDC_JWKS_URL=
# Further issuers whose tokens may only look addresses up (GET /healthz,
# /api/suggest/*, /api/streets, /api/reverse, ...; anything else answers
# 403), whatever their audience, comma or space separated: e.g. the issuer of
# a browser app that calls address-serv with its users' tokens to suggest
# addresses. In Authentik every application has its own issuer
# (https://sso.example.org/application/o/<slug>/). Their keys are found via
# OpenID discovery.
# OIDC_READONLY_ISSUER_URLS=https://auth.example.com/application/o/universam/
# Browser origins allowed to call the API: "*" (default) or a comma-separated
# list. List them for a browser app sending client certificates, which needs
# credentialed CORS.
# CORS_ALLOWED_ORIGIN=https://app.example.org,http://localhost:5173
# A reverse proxy terminating mTLS can name the verified client in this
# header (e.g. its certificate's subject DN). Such requests without a bearer
# token are read-only, like OIDC_READONLY_ISSUER_URLS. The header is accepted
# only from TRUSTED_PROXIES (comma-separated IPs or CIDRs), which it
# requires, and dropped from everyone else.
# PROXY_AUTH_HEADER=X-SSL-Client-DN
# TRUSTED_PROXIES=10.0.0.5,192.168.0.0/16
# Web UI (served at /ui/): the public OIDC client the browser signs in with,
# using the authorization code flow with PKCE. Register <base URL>/ui/callback
# as a redirect URI and <base URL>/ui/login as a post-logout redirect URI. The
# client's access tokens must carry OIDC_AUDIENCE in "aud".
# Defaults to OIDC_AUDIENCE.
# OIDC_CLIENT_ID=
# OIDC_SCOPE=openid profile email
# OpenID Connect back-channel logout: register <base URL>/auth/backchannel-logout
# as the provider's back-channel logout URL. Its logout tokens carry the
# client ID in "aud"; defaults to OIDC_CLIENT_ID (then OIDC_AUDIENCE).
# OIDC_LOGOUT_AUDIENCE=
# How long a logout is remembered (longer than the access tokens live).
# OIDC_LOGOUT_RETENTION=24h
# RabbitMQ sharing back-channel logouts with the API and the tile server: each
# service publishes the logouts it receives to one fanout exchange and applies
# the others' from its own durable queue. Unset: logouts apply here only.
# AMQP_URL=amqp://guest:guest@localhost:5672/
# AMQP_LOGOUT_EXCHANGE=oidc.logout
# AMQP_LOGOUT_QUEUE=oidc.logout.address
# Service discovery over the same RabbitMQ: with a secret shared by every TMD
# service (at least 32 bytes, e.g. openssl rand -base64 48), address-serv
# announces SERVICE_URL on the topic exchange tmd.services and hands API
# tokens to the services in SERVICE_TOKEN_CLIENTS (the tile server), so they
# need no hand-made token. Requests not signed with the secret are ignored.
# Each token belongs to the account service:<client>, one per requesting
# instance, and replaces the one issued to that instance before.
# SERVICE_DISCOVERY_SECRET=
# SERVICE_URL=http://address:8080
# SERVICE_TOKEN_CLIENTS=tiles
# SERVICE_TOKEN_TTL=168h
# SERVICE_ANNOUNCE_INTERVAL=1m
# Collectors: executables that return addresses to sync, see
# docs/collectors/contract.md. Defaults to a "collectors" folder next to the
# binary, which with `go run` is a build cache folder, so set it then.
# COLLECTORS_DIR=./collectors
# Who may manage collectors: members of this group, as listed in the OIDC
# token's "groups" claim (Authentik sends it; in Keycloak, add a group
# membership mapper). Unset, nobody can, and API tokens never can.
# COLLECTOR_ADMIN_GROUP=address-serv-admins
# A run's collector process is killed after this long (Go duration).
# COLLECTOR_TIMEOUT=10m
# Geo objects without a usable address are attached to the nearest house
# number within this many metres; 0 disables that.
# COLLECTOR_GEO_MAX_DISTANCE_M=100
# Runs kept per collector.
# COLLECTOR_RUN_HISTORY=50
# Collector schedules without a CRON_TZ= prefix use the server's time zone,
# which is UTC in the Docker image unless set here.
# TZ=Europe/Berlin
